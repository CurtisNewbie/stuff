{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "everforest",
    "mode": "system"
  },
  "plugins": [
    "oh-my-opencode-slim"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "low"
  },
  "animations": true,
  "tabs": {
    "layout": "horizontal",
    "indicators": "status",
    "mode": "off"
  },
  "keybinds": {
    "app.exit": [
      "ctrl+d",
      "<leader>q"
    ]
  },
  "scroll": {
    "acceleration": true
  },
  "debug": {
    "devtools": false
  },
  "terminal": {
    "copy": "select"
  }
}
