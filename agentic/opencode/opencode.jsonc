{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "openai": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "openai",
      "settings": {
        "baseURL": "{env:OC_API_HOST}",
        "apiKey": "{env:OC_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "attachment": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 1000000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ]
          }
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "attachment": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 1000000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text"
            ]
          }
        }
      }
    },
    "anthropic": {
      "npm": "aisdk:@ai-sdk/anthropic",
      "name": "anthropic",
      "settings": {
        "baseURL": "{env:OC_API_HOST}",
        "apiKey": "{env:OC_API_KEY}"
      },
      "models": {}
    }
  },
  "plugin": [],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*secrets/*": "deny",
      "*credential*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "external_directory": {
      "~/.opencode/opencode.json": "deny",
      "~/.opencode/opencode.jsonc": "deny",
      "~/.claude/settings.json": "deny",
      "*": "allow"
    }
  },
  "autoupdate": false
}