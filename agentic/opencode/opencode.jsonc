{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "openai": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "openai",
      "settings": {
        "baseURL": "{env:OC_API_HOST}",
        "apiKey": "{env:OC_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        }
      }
    },
    "anthropic": {
      "package": "aisdk:@ai-sdk/anthropic",
      "settings": {
        "baseURL": "{env:OC_API_HOST}",
        "apiKey": "{env:OC_API_KEY}"
      },
      "models": {}
    }
  },
  "plugins": [],
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*secrets/*", "effect": "deny" },
    { "action": "read", "resource": "*credential*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.opencode/opencode.json", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.opencode/opencode.jsonc", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.claude/settings.json", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "allow" }
  ],
  "update": "disable"
}